    // Busca produtos mais acessados
    // Implementação simplificada: retorna produtos mais visitados
    let all_edges = graph_get_client_pages("edges")
    let product_counts = ""
    
    // Conta acessos por produto
    let pos = 0
    while (pos < len(all_edges)) {
        let pipe_pos = index_of(substr(all_edges, pos, len(all_edges)), "|")
        let entry_end = pos
        if (pipe_pos >= 0) {
            entry_end = pos + pipe_pos
        } else {
            entry_end = len(all_edges)
        }
        
        let entry = substr(all_edges, pos, entry_end)
        if (index_of(entry, ":visited") >= 0 || index_of(entry, ":purchased") >= 0) {
            let arrow_pos = index_of(entry, "->")
            if (arrow_pos >= 0) {
                let rest = substr(entry, arrow_pos + 2, len(entry))
