// Teste de funções como cidadãos de primeira classe

// Teste 1: Atribuir função a variável
function soma(a, b) {
    return a + b;
}

let f = soma;
print("f é uma função:");
print(f);

// Teste 2: Chamada indireta
let resultado = f(2, 3);
print("f(2, 3) =");
print(resultado);

// Teste 3: Passar função como argumento
function apply(fn, x, y) {
    return fn(x, y);
}

let resultado2 = apply(soma, 5, 7);
print("apply(soma, 5, 7) =");
print(resultado2);

// Teste 4: Função anônima (através de variável)
let multiplica = function mult(a, b) {
    return a * b;
};

let resultado3 = multiplica(3, 4);
print("multiplica(3, 4) =");
print(resultado3);

