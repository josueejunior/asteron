# =============================================================================
# MAKEFILE FOR WASM SERVER
# =============================================================================

CC = gcc
CFLAGS = -Wall -Wextra -std=c11 -O2 -pthread
TARGET = wasm_server
SRC = src/server/wasm_server.c

# =============================================================================

.PHONY: all clean run

all: $(TARGET)

$(TARGET): $(SRC)
	@echo "Compiling Wasm server..."
	$(CC) $(CFLAGS) -o $(TARGET) $(SRC)
	@echo "✓ Server compiled: $(TARGET)"

clean:
	rm -f $(TARGET)

run: $(TARGET)
	@echo "Starting server on port 8080..."
	./$(TARGET) 8080

run-port: $(TARGET)
	@echo "Starting server on port $(PORT)..."
	@if [ -z "$(PORT)" ]; then \
		echo "ERROR: Specify PORT=XXXX"; \
		exit 1; \
	fi
	./$(TARGET) $(PORT)

help:
	@echo "Usage:"
	@echo "  make          - Compile server"
	@echo "  make run       - Compile and run on port 8080"
	@echo "  make run PORT=3000 - Compile and run on port 3000"
	@echo "  make clean     - Remove compiled files"

